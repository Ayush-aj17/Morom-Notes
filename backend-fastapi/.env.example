# copy to .env and fill in values for production
DATABASE_URL=sqlite:///./app.db  # or postgres://user:pass@host/db
SECRET_KEY=replace-with-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # one week
env: PACKAGES etc? not needed
UPLOAD_DIR=uploads
# maximum allowed upload size in megabytes (server-side check)
MAX_UPLOAD_SIZE_MB=100
# set to true when running automated tests
TESTING=1
# GEMINI_API_KEY or other API keys

# Email settings for OTP delivery
# For Gmail:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password
# 4. Use your Gmail address below and the generated app password
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
