# copy to .env and fill in values for production
DATABASE_URL=sqlite:///./app.db  # or postgres://user:pass@host/db
SECRET_KEY=replace-with-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # one week
env: PACKAGES etc? not needed
UPLOAD_DIR=uploads
# maximum allowed upload size in megabytes (server-side check)
MAX_UPLOAD_SIZE_MB=100
# set to true only when running automated tests
TESTING=0
GEMINI_API_KEY=your-gemini-api-key
# Optional browser cookies for videos blocked by bot checks.
# Use the browser where YouTube is already signed in.
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
# Optional profile: YOUTUBE_COOKIES_FROM_BROWSER=chrome:Default
# Alternatively use a Netscape-format cookie file:
# YOUTUBE_COOKIES_FILE=/absolute/path/to/youtube-cookies.txt

# Resend settings for OTP delivery
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
